{
  "name": "@careorbit/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/app.test.js",
    "test:auth": "npm run build && node --test dist/auth/auth.test.js",
    "test:profiles": "npm run build && node --test dist/profiles/profiles.test.js",
    "test:discovery": "npm run build && node --test dist/discovery/discovery.test.js",
    "test:scheduling": "npm run build && node --test dist/scheduling/scheduling.test.js",
    "test:appointments": "npm run build && node --test dist/appointments/appointments.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jose": "^6.2.13",
    "multer": "^2.5.0",
    "pg": "^8.16.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "~5.9.3"
  }
}
