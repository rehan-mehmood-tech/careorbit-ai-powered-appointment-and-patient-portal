NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
CLIENT_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DATABASE_URL=postgresql://replace-user:replace-password@127.0.0.1:5432/careorbit
AI_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
REQUEST_BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY=0
REQUIRE_TLS=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DEFAULT_MAX=120
RATE_LIMIT_AUTH_MAX=10
JWT_SIGNING_KEYS=local-v1:replace-with-at-least-32-random-characters-for-local-only
JWT_ISSUER=careorbit-api
JWT_AUDIENCE=careorbit-web
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=30
BCRYPT_ROUNDS=12
AUTH_TOKEN_TTL_MINUTES=30
COOKIE_DOMAIN=
PRIVATE_UPLOAD_DIR=../.runtime/verification-artifacts
VERIFICATION_MAX_FILE_BYTES=10000000
DOCUMENT_STORAGE_DIR=../.runtime/documents
DOCUMENT_ENCRYPTION_KEY=replace-with-32-byte-document-encryption-key
DOCUMENT_SIGNING_SECRET=replace-with-32-byte-document-signing-secret
DOCUMENT_URL_TTL_SECONDS=120
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=careorbit-local
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key
S3_FORCE_PATH_STYLE=true
APPOINTMENT_CONFIRMATION_MINUTES=1440
APPOINTMENT_CANCELLATION_CUTOFF_MINUTES=120
APPOINTMENT_NO_SHOW_GRACE_MINUTES=15
APPOINTMENT_AUTO_CONFIRM=false
