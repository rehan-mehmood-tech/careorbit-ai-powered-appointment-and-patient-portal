# CareOrbit local stack reference. Copy client values to client/.env.local,
# server values to server/.env, and AI values to ai-service/.env.
VITE_APP_NAME=CareOrbit
VITE_APP_URL=http://127.0.0.1:3000
VITE_API_URL=http://127.0.0.1:3001
VITE_AI_API_URL=http://127.0.0.1:8000
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Node.js/Express API, PostgreSQL, worker, and local object storage
# -----------------------------------------------------------------------------
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
CLIENT_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
REQUEST_BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000
DATABASE_URL=postgresql://replace-user:replace-password@localhost:5432/careorbit
DATABASE_TEST_URL=postgresql://replace-user:replace-password@localhost:5432/careorbit_test
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECRET=replace-with-at-least-32-random-bytes
REDIS_URL=redis://localhost:6379/0
POSTGRES_DB=careorbit
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
WORKER_HEALTH_PORT=3002
WORKER_CONCURRENCY=4
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=careorbit-local
S3_ACCESS_KEY_ID=replace-with-local-access-key
S3_SECRET_ACCESS_KEY=replace-with-local-secret-key
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=50
DOCUMENT_STORAGE_DIR=../.runtime/documents
DOCUMENT_ENCRYPTION_KEY=replace-with-32-byte-document-encryption-key
DOCUMENT_SIGNING_SECRET=replace-with-32-byte-document-signing-secret
DOCUMENT_URL_TTL_SECONDS=120
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=CareOrbit <no-reply@localhost>
LOG_LEVEL=debug
