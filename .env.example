# CareOrbit web client (Vite)
# Copy this file to .env.local. Only VITE_* values are exposed to the browser.
VITE_APP_NAME=CareOrbit
VITE_APP_URL=http://localhost:5173
VITE_AI_API_URL=http://127.0.0.1:8000
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Planned Node.js/Express API, PostgreSQL, worker, and object storage
# -----------------------------------------------------------------------------
# The current repository does not contain these services. These names document
# the PRD's expected configuration for when those packages are added; the
# current Vite/FastAPI application does not read them.
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://careorbit:careorbit@localhost:5432/careorbit
DATABASE_TEST_URL=postgresql://careorbit:careorbit@localhost:5432/careorbit_test
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=4
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=careorbit-local
S3_ACCESS_KEY_ID=replace-with-local-access-key
S3_SECRET_ACCESS_KEY=replace-with-local-secret-key
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=50
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=CareOrbit <no-reply@localhost>
LOG_LEVEL=debug
