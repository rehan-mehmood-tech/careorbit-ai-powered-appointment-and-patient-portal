# CareOrbit FastAPI AI intake service
# Copy to ai-service/.env and replace secrets/identifiers.
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile
FIREBASE_PROJECT_ID=your-project-id

# Absolute path to a Firebase service-account JSON file. For local development,
# Application Default Credentials from `gcloud auth application-default login`
# can be used instead, in which case this may be left blank or omitted.
GOOGLE_APPLICATION_CREDENTIALS=

ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CHECKPOINT_DB=./data/checkpoints.sqlite
PROMPT_VERSION=careorbit-intake-v1
REQUEST_TIMEOUT_SECONDS=25
