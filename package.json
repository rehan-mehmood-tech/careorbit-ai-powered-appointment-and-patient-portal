{
  "name": "careorbit",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["client", "server", "worker", "database"],
  "scripts": {
    "install:all": "npm ci && npm run ai:install",
    "ai:install": "node scripts/ai-service.mjs install",
    "dev": "concurrently --kill-others-on-fail --names client,server,ai,worker --prefix-colors cyan,green,magenta,yellow \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:ai\" \"npm run dev:worker\"",
    "dev:client": "npm run dev --workspace @careorbit/client",
    "dev:server": "npm run dev --workspace @careorbit/server",
    "dev:ai": "node scripts/ai-service.mjs dev",
    "dev:worker": "npm run dev --workspace @careorbit/worker",
    "build": "npm run build --workspaces --if-present && npm run build:ai",
    "build:client": "npm run build --workspace @careorbit/client",
    "build:server": "npm run build --workspace @careorbit/server",
    "build:worker": "npm run build --workspace @careorbit/worker",
    "build:ai": "node scripts/ai-service.mjs check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run migrate --workspace @careorbit/database",
    "db:rollback": "npm run rollback --workspace @careorbit/database",
    "db:seed": "npm run seed --workspace @careorbit/database",
    "db:verify": "npm run verify --workspace @careorbit/database",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:verify",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.12 <25"
  }
}
